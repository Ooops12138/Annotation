# Annotation（书注）环境配置
# 按用途分组；空值表示未配置，布尔开关使用 true / false。
# 密钥只填写在本地 .env 中，请勿提交 .env。

# ====================================================================
# 基础运行与服务地址
# ====================================================================
# 运行环境标识，例如 development。
ANNOTATION_ENV=development
# 可选绝对存储根目录，默认使用仓库下的 storage/。
# 需在启动 Python 前设置到进程环境中。
# ANNOTATION_STORAGE_DIR=D:/AnnotationData
# 教材解析配置版本；更换本地 OCR、公式模型文件或识别配置后递增。
ANNOTATION_SOURCE_CONFIG_VERSION=1
# 后端监听地址，127.0.0.1 仅允许本机访问。
ANNOTATION_API_HOST=127.0.0.1
# 后端监听端口。
ANNOTATION_API_PORT=8000
# 前端请求的后端地址，应与实际后端服务地址一致。
VITE_API_BASE_URL=http://127.0.0.1:8000

# ====================================================================
# 生成模型：模式与连接
# ====================================================================
# offline 使用确定性测试数据；live 调用真实模型服务。
MODEL_PROFILE=offline
# live 模式必填：openai、openai-compatible、deepseek、ollama 或 vllm。
MODEL_PROVIDER=
# 模型 API 基础地址；DeepSeek 留空默认 https://api.deepseek.com/v1，其他兼容服务需填写。
MODEL_BASE_URL=
# 模型名称；offline 可使用 offline-fixture，live 应填写服务支持的模型名。
MODEL_NAME=offline-fixture
# 生成模型的 API 密钥，仅在本地 .env 中填写。
MODEL_API_KEY=
# 模型配置版本标识，用于区分不同生成配置。
MODEL_CONFIG_VERSION=env-v1
# DeepSeek 思考模式，默认 disabled；是否支持取决于模型服务。
MODEL_THINKING=disabled

# ====================================================================
# 生成模型：请求限制与 Token 估算
# ====================================================================
# 单次模型请求超时，单位：秒。
MODEL_TIMEOUT_SECONDS=120
# 模型请求失败后的最大重试次数。
MODEL_MAX_RETRIES=1
# 结构化 JSON 响应的共享输出 Token 上限，受模型服务能力约束。
MODEL_MAX_OUTPUT_TOKENS=8000

# ====================================================================
# Learning Blueprint：生成预算与缓存
# ====================================================================
# Blueprint 最大尝试次数，包含首次生成。
BLUEPRINT_MAX_ATTEMPTS=3
# Blueprint 输入 Token 预算，包含 schema；输出预算另行预留。
BLUEPRINT_INPUT_BUDGET_TOKENS=16000
# 一次运行中 Blueprint 实际模型请求次数上限。
BLUEPRINT_MAX_CALLS=1000
# Blueprint 协调器的工具步骤上限。
BLUEPRINT_COORDINATION_MAX_STEPS=6
# 是否启用 Blueprint 缓存：true / false。
BLUEPRINT_CACHE_ENABLED=true
# 可选缓存目录覆盖，默认使用 ANNOTATION_STORAGE_DIR/cache/blueprint。
# BLUEPRINT_CACHE_PATH=storage/cache/blueprint

# ====================================================================
# 内容生成与工作流并发
# ====================================================================
# 每个知识单元的内容反思最大尝试次数，包含首次生成。
CONTENT_REFLECTION_MAX_ATTEMPTS=3
# 单次运行中内容、测验和事实核查的并行任务数，范围 1–8；1 表示串行。
WORKFLOW_MAX_WORKERS=2

# ====================================================================
# 事实核查与纠错
# ====================================================================
# 每个知识单元基于教材的定向纠错次数上限；A-003 最多允许 2 次。
FACT_CHECK_MAX_CORRECTIONS=2
# 每个知识单元核查的事实主张数量上限。
FACT_CHECK_MAX_CLAIMS_PER_UNIT=20
# 优先检查 ContextPack 证据；true 允许追加全文或联网检索，联网仍受相关开关约束。
FACT_CHECK_ADDITIONAL_RETRIEVAL_ENABLED=true
# 是否允许事实核查使用外部搜索；还需启用并配置 WEB_SEARCH。
FACT_CHECK_WEB_ENABLED=false
# 每个知识单元的外部搜索查询预算，最大 20；0 表示无查询预算。
FACT_CHECK_WEB_QUERY_LIMIT=10

# ====================================================================
# 外部搜索服务
# ====================================================================
# 内容与事实核查的外部搜索总开关；启用前配置 API 密钥和域名白名单。
WEB_SEARCH_ENABLED=false
# 外部搜索服务提供方，当前示例为 tavily。
WEB_SEARCH_PROVIDER=tavily
# 搜索服务 API 密钥，仅在本地 .env 中填写。
WEB_SEARCH_API_KEY=
# 搜索服务请求地址。
WEB_SEARCH_ENDPOINT=https://api.tavily.com/search
# 允许检索的域名白名单，多个域名以英文逗号分隔。
WEB_SEARCH_ALLOWED_DOMAINS=
# 搜索请求超时，单位：秒。
WEB_SEARCH_TIMEOUT_SECONDS=10
# 单次搜索返回的结果数量上限。
WEB_SEARCH_MAX_RESULTS=5

# ====================================================================
# RAG：开关与向量存储
# ====================================================================
# 是否启用可选 RAG 层；启用 Chroma 前需安装 rag 可选依赖。
RAG_ENABLED=false
# 向量存储配置，当前示例为 chroma。
RAG_VECTOR_STORE=chroma
# Chroma 持久化目录，相对路径以运行时工作目录为基准。
RAG_CHROMA_PATH=storage/chroma

# ====================================================================
# RAG：嵌入模型选择与通用参数
# ====================================================================
# auto：初始化时探测已配置的 API，不可用则使用本地 CPU；local / api：显式指定，不自动回退。
RAG_EMBEDDING_PROVIDER=auto
# 嵌入请求或本地编码的批大小。
RAG_EMBEDDING_BATCH_SIZE=16
# 嵌入 API 请求超时，单位：秒。
RAG_EMBEDDING_TIMEOUT_SECONDS=30
# 嵌入 API 请求失败后的最大重试次数。
RAG_EMBEDDING_MAX_RETRIES=2

# ====================================================================
# RAG：本地嵌入模型
# ====================================================================
# 本地模型的 Hugging Face ID 或 sentence-transformers 模型目录。
RAG_EMBEDDING_MODEL_PATH=BAAI/bge-small-zh-v1.5
# 本地模型版本，留空使用模型默认版本。
RAG_EMBEDDING_REVISION=
# 可选查询指令覆盖；不设置时中文 BGE 使用推荐指令，显式留空则禁用指令。
# RAG_EMBEDDING_QUERY_INSTRUCTION=

# ====================================================================
# RAG：远程嵌入 API
# ====================================================================
# 兼容 OpenAI embeddings 协议的 API 基础地址。
RAG_EMBEDDING_API_BASE_URL=https://api.siliconflow.cn/v1
# 嵌入服务专用密钥；显式使用 api 模式时必填，仅在本地 .env 中填写。
RAG_EMBEDDING_API_KEY=
# 远程嵌入模型名称，应与嵌入服务支持的模型一致。
RAG_EMBEDDING_API_MODEL=BAAI/bge-m3
