ANNOTATION_ENV=development
ANNOTATION_API_HOST=127.0.0.1
ANNOTATION_API_PORT=8000
VITE_API_BASE_URL=http://127.0.0.1:8000
# Use mock for offline development; openai/openai-compatible for real endpoints.
MODEL_PROVIDER=mock
# For DeepSeek you may omit MODEL_BASE_URL; the factory defaults it to
# https://api.deepseek.com/v1. Keep MODEL_NAME and MODEL_API_KEY set locally.
MODEL_BASE_URL=
MODEL_NAME=fixture-model
MODEL_API_KEY=
MODEL_CONFIG_VERSION=env-v1
MODEL_TIMEOUT_SECONDS=120
MODEL_MAX_RETRIES=1
# Shared upper bound for structured JSON responses (provider permitting).
MODEL_MAX_OUTPUT_TOKENS=8000
# DeepSeek defaults to disabled reasoning for predictable structured JSON.
MODEL_THINKING=disabled
# Maximum Blueprint loop attempts, including the initial generation.
BLUEPRINT_MAX_ATTEMPTS=3
# Conservative UTF-8 input estimate, including schema; output space is reserved separately.
BLUEPRINT_INPUT_BUDGET_TOKENS=16000
# Run-level actual model requests; each coordinator also has bounded tool steps.
BLUEPRINT_MAX_CALLS=1000
BLUEPRINT_COORDINATION_MAX_STEPS=6
BLUEPRINT_CACHE_ENABLED=true
BLUEPRINT_CACHE_PATH=storage/cache/blueprint
# Maximum content reflection attempts per knowledge unit, including the initial generation.
CONTENT_REFLECTION_MAX_ATTEMPTS=3
# A-003 allows at most two textbook-grounded targeted corrections per unit.
FACT_CHECK_MAX_CORRECTIONS=2
FACT_CHECK_MAX_CLAIMS_PER_UNIT=20
# External resource search is opt-in and no provider is configured by default.
FACT_CHECK_WEB_ENABLED=false
FACT_CHECK_WEB_QUERY_LIMIT=10
# ContextPack evidence is always checked first. Additional FTS/web retrieval is opt-in.
FACT_CHECK_ADDITIONAL_RETRIEVAL_ENABLED=false
# Content/fact-check web search. Keep disabled until an API key and allowlist are set.
WEB_SEARCH_ENABLED=false
WEB_SEARCH_PROVIDER=tavily
WEB_SEARCH_API_KEY=
WEB_SEARCH_ENDPOINT=https://api.tavily.com/search
WEB_SEARCH_ALLOWED_DOMAINS=
WEB_SEARCH_TIMEOUT_SECONDS=10
WEB_SEARCH_MAX_RESULTS=5
# Optional RAG layer (install the `rag` extra before enabling Chroma).
RAG_ENABLED=false
RAG_VECTOR_STORE=chroma
RAG_CHROMA_PATH=storage/chroma
RAG_EMBEDDING_PROVIDER=auto
# auto: probe configured embedding API once; absent/unavailable API selects CPU.
# local/api: use that provider explicitly, without automatic fallback.
# Local provider: Hugging Face ID or a sentence-transformers model directory.
RAG_EMBEDDING_MODEL_PATH=BAAI/bge-small-zh-v1.5
RAG_EMBEDDING_REVISION=
# Optional override; BGE Chinese models use their recommended query instruction.
# RAG_EMBEDDING_QUERY_INSTRUCTION=
RAG_EMBEDDING_BATCH_SIZE=16
RAG_EMBEDDING_TIMEOUT_SECONDS=30
RAG_EMBEDDING_MAX_RETRIES=2
# API provider: OpenAI-compatible embeddings endpoint and credentials.
RAG_EMBEDDING_API_BASE_URL=https://api.siliconflow.cn/v1
RAG_EMBEDDING_API_KEY=
RAG_EMBEDDING_API_MODEL=BAAI/bge-m3
# Keep secrets local; never commit .env.
