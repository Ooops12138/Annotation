ANNOTATION_ENV=development
ANNOTATION_API_HOST=127.0.0.1
ANNOTATION_API_PORT=8000
VITE_API_BASE_URL=http://127.0.0.1:8000
# Use mock for offline development; openai/openai-compatible for real endpoints.
MODEL_PROVIDER=mock
# For DeepSeek you may omit MODEL_BASE_URL; the factory defaults it to
# https://api.deepseek.com/v1. Keep MODEL_NAME and MODEL_API_KEY set locally.
MODEL_BASE_URL=
MODEL_NAME=fixture-model
MODEL_API_KEY=
MODEL_CONFIG_VERSION=env-v1
MODEL_TIMEOUT_SECONDS=120
MODEL_MAX_RETRIES=1
# DeepSeek defaults to disabled reasoning for predictable structured JSON.
MODEL_THINKING=disabled
# Maximum Blueprint loop attempts, including the initial generation.
BLUEPRINT_MAX_ATTEMPTS=3
# Maximum content reflection attempts per knowledge unit, including the initial generation.
CONTENT_REFLECTION_MAX_ATTEMPTS=3
# A-003 allows at most two textbook-grounded targeted corrections per unit.
FACT_CHECK_MAX_CORRECTIONS=2
FACT_CHECK_MAX_CLAIMS_PER_UNIT=20
# External resource search is opt-in and no provider is configured by default.
FACT_CHECK_WEB_ENABLED=false
FACT_CHECK_WEB_QUERY_LIMIT=10
# Keep secrets local; never commit .env.
